                <mxCell id="hotel" value="&lt;b&gt;Hoteling&lt;/b&gt;&lt;br&gt;&lt;b&gt;Não somado separadamente&lt;/b&gt;&lt;br&gt;quando a intensidade MRV por trabalho de transporte está ativa" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#F4CCCC;strokeColor=#C00000;fontSize=13;" parent="1" vertex="1">
