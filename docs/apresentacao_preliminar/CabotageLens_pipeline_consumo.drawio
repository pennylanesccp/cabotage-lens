                <mxCell id="scope" value="Fluxo principal sem fallback: rotas resolvidas + intensidade marítima direcional ANTAQ–MRV" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fillColor=#D9EAF7;strokeColor=#5B9BD5;strokeWidth=1;" parent="1" vertex="1">
