                <mxCell id="portops" value="&lt;b&gt;Operações portuárias&lt;/b&gt;&lt;br&gt;movimentos × L/movimento&lt;br&gt;RTG + caminhão interno × 2 chamadas" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#FFF2CC;strokeColor=#BF9000;" parent="1" vertex="1">
