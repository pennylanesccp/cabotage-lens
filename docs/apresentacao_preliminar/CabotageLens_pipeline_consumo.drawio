                <mxCell id="inputs" value="&lt;b&gt;1. Entradas do cenário&lt;/b&gt;&lt;br&gt;Origem • destino • carga (t e/ou TEU)&lt;br&gt;preset de caminhão • classe do navio • parâmetros portuários" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#E2F0D9;strokeColor=#70AD47;fontStyle=1;" parent="1" vertex="1">
