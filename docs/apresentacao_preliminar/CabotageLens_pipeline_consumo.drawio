                    <mxGeometry x="805" y="800" width="750" height="800" as="geometry"/>
                </mxCell>
                <mxCell id="road_spec" value="&lt;b&gt;Configuração do caminhão&lt;/b&gt;&lt;br&gt;eixos • payload • peso de referência&lt;br&gt;η&lt;sub&gt;base&lt;/sub&gt; em km/L" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#FCE4D6;strokeColor=#ED7D31;" parent="1" vertex="1">
                    <mxGeometry x="265" y="875" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="road_trips" value="&lt;b&gt;Número de viagens&lt;/b&gt;&lt;br&gt;N = ceil(carga / payload)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#FCE4D6;strokeColor=#ED7D31;" parent="1" vertex="1">
                    <mxGeometry x="135" y="1040" width="270" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="road_eta" value="&lt;b&gt;Eficiência carregada&lt;/b&gt;&lt;br&gt;η = η&lt;sub&gt;base&lt;/sub&gt;[1 − ε(payload−ref)/ref]" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#A6A6A6;fontFamily=Courier New;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="445" y="1040" width="270" height="95" as="geometry"/>
                </mxCell>
                <mxCell id="road_liters" value="&lt;b&gt;Combustível rodoviário&lt;/b&gt;&lt;br&gt;L&lt;sub&gt;direta&lt;/sub&gt; = D&lt;sub&gt;direta&lt;/sub&gt; / η × N" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#FFFFFF;strokeColor=#A6A6A6;fontFamily=Courier New;fontSize=12;" parent="1" vertex="1">
                    <mxGeometry x="265" y="1210" width="320" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="road_emis" value="&lt;b&gt;Emissões rodoviárias&lt;/b&gt;&lt;br&gt;E&lt;sub&gt;direta&lt;/sub&gt; = L&lt;sub&gt;direta&lt;/sub&gt; × 2,68 kg CO₂e/L" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#FCE4D6;strokeColor=#ED7D31;" parent="1" vertex="1">
                    <mxGeometry x="135" y="1390" width="270" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="road_cost" value="&lt;b&gt;Custo modelado&lt;/b&gt;&lt;br&gt;C&lt;sub&gt;direta&lt;/sub&gt; = L&lt;sub&gt;direta&lt;/sub&gt; × preço do diesel" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#FCE4D6;strokeColor=#ED7D31;" parent="1" vertex="1">
                    <mxGeometry x="445" y="1390" width="270" height="105" as="geometry"/>
                </mxCell>
                <mxCell id="first" value="&lt;b&gt;First mile&lt;/b&gt;&lt;br&gt;&lt;i&gt;origem → porto de embarque&lt;/i&gt;&lt;br&gt;Mesma fórmula rodoviária: L = D/η × N" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#FCE4D6;strokeColor=#ED7D31;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="870" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="sea" value="&lt;b&gt;Navegação&lt;/b&gt;&lt;br&gt;&lt;i&gt;porto de embarque → porto de descarga&lt;/i&gt;&lt;br&gt;F&lt;sub&gt;sea&lt;/sub&gt; = I&lt;sub&gt;rota&lt;/sub&gt; × carga × D&lt;sub&gt;nm&lt;/sub&gt; / 1000&lt;br&gt;I em g/(t·nm)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#D9E1F2;strokeColor=#4472C4;" parent="1" vertex="1">
                    <mxGeometry x="1065" y="1015" width="290" height="125" as="geometry"/>
                </mxCell>
                <mxCell id="last" value="&lt;b&gt;Last mile&lt;/b&gt;&lt;br&gt;&lt;i&gt;porto de descarga → destino&lt;/i&gt;&lt;br&gt;Mesma fórmula rodoviária: L = D/η × N" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#FCE4D6;strokeColor=#ED7D31;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="1200" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="teu" value="&lt;b&gt;Resolver TEU&lt;/b&gt;&lt;br&gt;TEU = ceil(carga/14) se não informado" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;strokeWidth=2;fillColor=#FFF2CC;strokeColor=#BF9000;" parent="1" vertex="1">
